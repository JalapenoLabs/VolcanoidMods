root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4
max_line_length = 120
# K&R style: braces on the same line for everything
csharp_new_line_before_open_brace = none

[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{json,yml,yaml,csproj,props}]
indent_style = space
indent_size = 2
