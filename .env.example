# Copy to .env and fill in your machine's paths. scripts/mods.py reads this file.

# The Volcanoids install folder (the one holding Volcanoids_Data/).
# Windows: C:\Program Files (x86)\Steam\steamapps\common\Volcanoids
VOLCANOIDS_DIR=/mnt/FreightBay/SteamLibrary/steamapps/common/Volcanoids

# The game's persistent data folder (Unity's Application.persistentDataPath).
# It holds Saves/, LocalMods/ and mods.json.
# Windows: %USERPROFILE%\AppData\LocalLow\Volcanoid\Volcanoids
VOLCANOIDS_DATA_DIR=~/.config/unity3d/Volcanoid/Volcanoids
