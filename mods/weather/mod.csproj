<Project Sdk="Microsoft.NET.Sdk">
  <!-- Target framework, game references and build flags shared by every mod. -->
  <Import Project="../../build/VolcanoidsMod.props" />

  <PropertyGroup>
    <RootNamespace>JalapenoLabs.Weather</RootNamespace>
    <AssemblyName>JalapenoLabs.Weather</AssemblyName>
    <OutputPath>bin</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Source/**/*.cs" />
    <!-- Code shared between the mods (developer capture tooling); each mod compiles its own copy. -->
    <Compile Include="../../shared/**/*.cs" />
  </ItemGroup>
</Project>
